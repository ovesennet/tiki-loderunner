# Build output - everything here is produced by build.ps1 / deploy.ps1 / tests
build/

# z88dk per-file symbol dumps, written next to each source file
*.sym

# Python bytecode
__pycache__/
*.pyc

# Generated MAME ROM set - rebuild with tools\make-mame-romset.py
roms/

# Disposable CP/M images. workbase.dsk is the pristine base and IS tracked;
# work.dsk and dsk\work\ are regenerated by deploy.ps1 on every run.
dsk/work.dsk
dsk/work/
dsk/loderun.dsk

# Emulator scratch
*.sta
*.inp

# Internal design document, not part of the published port
Lode-Runner-Tiki-100-Implementation-Plan.md

# Internal working notes for the coding agent, not part of the published port
.github/
